VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Web push notifications — generate a pair with `npx web-push generate-vapid-keys`
# The public key MUST be VITE_-prefixed so Vite exposes it to the browser bundle.
# The private key MUST NOT be VITE_-prefixed — it stays server-only (used in api/_lib/webpush.js).
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# Server-side only (Vercel env vars) — used by /api routes
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Claude API key — server-only, never VITE_-prefixed. The frontend calls
# /api/claude/* endpoints, which use this key to talk to the Anthropic API.
# Never expose this as VITE_CLAUDE_API_KEY again — that bundles it into the
# browser JS and anyone can read it from devtools.
CLAUDE_API_KEY=sk-ant-...

# Google Calendar OAuth — see README for Google Cloud Console setup
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=https://curly-sniffle-seven.vercel.app/api/auth/google/callback

# Twilio SMS — see README for setup (two-way SMS + 8am morning briefing).
# Each user's own number lives in the profiles table (Settings → Account),
# not in an env var — this app supports multiple users texting the same
# Twilio number.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=your-twilio-api-key-secret
TWILIO_PHONE_NUMBER=+15551234567

# Optional — set this and Vercel will send it as a Bearer token when triggering
# the morning-briefing cron job, so the endpoint can verify the request
CRON_SECRET=a-long-random-string
